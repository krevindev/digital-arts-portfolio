---
import HeroHeader from "../HeroHeader.astro";
import { Image } from "astro:assets";
import { ArrowDownRight } from "@lucide/astro";
---

<!--=== HERO SECTION ===-->
<section class="bg-black h-screen w-full text-white flex justify-between items-stretch relative">

  <!-- Image Part -->
  <div class="relative w-fit">
    <Image 
      class="object-cover min-w-[40vw] w-full h-full" 
      src="/assets/images/hero1.svg"
      width={400}
      height={800}
      alt="Hero Image"
    />
  </div>

  <!-- Text Part -->
  <div class="bg-background w-full flex flex-col relative">
      <Image 
      class="object-cover fixed w-[400vw] right-0 opacity-5 blur-xl h-full" 
      src="/assets/images/hero1.svg"
      width={400}
      height={800}
      alt="Hero Image"
    />

    <!-- Blurry Elements -->
<div class="w-200 h-50 bg-purple-400 absolute left-0 bottom-0 rounded-full opacity-5 -rotate-30 blur-3xl z-0"/>
    <div class="w-100 h-100 bg-pink-400 absolute right-1/2 top-1/2 rounded-full opacity-10 -rotate-30 blur-3xl z-0"/>
    <div class="w-100 h-100 bg-pink-400 absolute left-1/2 bottom-0 rounded-full opacity-5 -rotate-30 blur-3xl z-0"/>


    <!-- == Hero Header == -->
    <HeroHeader/>

    <!-- == Main Text Contents Container == -->
    <div class="h-full flex flex-col justify-center items-start justify-self-center w-full px-20">
      <!-- Eyebrow -->
      <p class="text-sm text-gray-500 tracking-[5px]">// PROJECT 0441</p>
      <!-- Headline/Title -->
      <h1 class="text-[clamp(2.5rem,6vw,9rem)] my-5 leading-[0.9] font-extrabold">
        NO REST FOR <span class="text-primary">THE WICKED</span>
      </h1>
      <!-- Description -->
      <p class="text-[#8C8CA9] font-light text-sm">
      Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
      </p>

      <!-- CTA: Explore button -->
      <button class="mt-5 transition-all text-white/40 hover:text-white border border-white/40 hover:border-white flex justify-center items-center px-6 py-2 z-10 cursor-pointer group">
        EXPLORE THE ARCHIVE
        <ArrowDownRight class="group-hover:translate-x-0.5 group-hover:translate-y-0.5 text-white/40 group-hover:text-white transition-all"/>
    </button>

    </div>


      </div>
</section>
